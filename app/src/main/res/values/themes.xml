<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TrenNex" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimary</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- Backgrounds -->
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>

        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>

        <!-- Status / Error -->
        <item name="colorError">@color/colorError</item>
        <item name="colorControlNormal">@color/colorPrimary</item>

        <!-- Navigation / Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/black</item>

        <!-- Ripple / Control Colors -->
        <item name="colorControlHighlight">@color/ripplePrimary</item>
        <item name="android:fontFamily">@font/poppins</item>

    </style>

    <style name="Theme.TrenNex" parent="Base.Theme.TrenNex" />

    <style name="Theme.TrenNex.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="LoginInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="errorTextColor">@color/colorError</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/hint_selector</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="errorEnabled">true</item>
        <item name="hintEnabled">true</item>
    </style>

    <style name="LoginEditTextStyle" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/textPlaceholder</item> </style>

    <style name="AccountInputLayout" parent="@style/LoginInputLayout">
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
    </style>

    <style name="OtpEditText">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLength">1</item>
        <item name="android:inputType">number</item>
        <item name="android:importantForAutofill">yes</item>
        <item name="android:background">@drawable/otp_default</item>
    </style>

    <style name="PopupAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_left_to_right</item>
        <item name="android:windowExitAnimation">@anim/fade_out_wishlist</item>

    </style>

    <style name="ThemeOverlay.TrenNex.PopupMenu" parent="ThemeOverlay.MaterialComponents.Light">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="popupMenuStyle">@style/Widget.TrenNex.PopupMenu</item>
    </style>

    <style name="Widget.TrenNex.PopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
    </style>


</resources>