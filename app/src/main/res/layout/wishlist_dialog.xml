<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="300dp"
    android:background="@drawable/bg_ll_background"
    android:padding="12dp"
    android:layout_height="wrap_content">


    <ImageView
        android:id="@+id/close_iv"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="end"
        android:padding="2dp"
        android:src="@drawable/baseline_close_24"/>
    
    <androidx.cardview.widget.CardView
        android:id="@+id/product_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:elevation="2dp"
        android:background="@color/white"
        android:layout_marginHorizontal="5dp"
        app:cardBackgroundColor="@color/white"
       >


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <ImageView
                android:id="@+id/imgProduct"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/samsung_mobile"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remove From WishList"
                android:textSize="12sp"
                android:layout_marginStart="16dp"
                android:textStyle="bold"
                android:textColor="@color/black"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#EEEEEE" />

    <androidx.cardview.widget.CardView
        android:id="@+id/go_to_wishlist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:elevation="2dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/white"
        android:layout_marginHorizontal="5dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/wishlist_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="4dp"
            android:src="@drawable/remove_wishlist_icon"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Go To WishList"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:textColor="@color/black"/>

    </LinearLayout>

    </androidx.cardview.widget.CardView>


</LinearLayout>