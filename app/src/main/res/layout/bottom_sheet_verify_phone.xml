<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="370dp"
    android:background="@drawable/bg_bottom_sheet_top"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/successContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/otpContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="64dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="Verify Phone"
                android:textColor="@color/black"
                android:textSize="23sp" />

            <TextView
                android:id="@+id/tvOtpSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="Enter the 6 digit OTP sent to +91 XXXXXXXXXX"
                android:textColor="@color/textSecondary"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/otp1"
                    style="@style/OtpEditText" />

                <EditText
                    android:id="@+id/otp2"
                    style="@style/OtpEditText" />

                <EditText
                    android:id="@+id/otp3"
                    style="@style/OtpEditText" />

                <EditText
                    android:id="@+id/otp4"
                    style="@style/OtpEditText" />

                <EditText
                    android:id="@+id/otp5"
                    style="@style/OtpEditText" />

                <EditText
                    android:id="@+id/otp6"
                    style="@style/OtpEditText" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/successContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/successCircle"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:background="@drawable/bg_success_circle"
                android:scaleX="0"
                android:scaleY="0">

                <ImageView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="center"
                    android:src="@drawable/baseline_check_24" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Phone Verified"
                android:textColor="@color/black"
                android:textSize="22sp" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerifyUpdate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="@color/colorPrimary"
        android:fontFamily="@font/poppins_regular"
        android:text="Update"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:cornerRadius="0dp" />
</LinearLayout>