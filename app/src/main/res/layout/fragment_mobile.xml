<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.category.subcategories.MobileFragment">

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/bg_fashion_banner"
        android:padding="12dp"
        android:id="@+id/mobile_banner"

        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
      >

        <TextView
            android:id="@+id/tvSmartphone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All Smartphones  >"
            android:textColor="@color/colorPrimary"
            android:textStyle="bold"
            android:layout_marginStart="12dp"
            android:textSize="16sp"
            />
        <Space
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/ivSmartphone"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/mobiles_category"
            />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_shop_by_brand"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Shop By Brand"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="@color/textPrimary"
        app:layout_constraintStart_toStartOf="@+id/mobile_banner"
        app:layout_constraintTop_toBottomOf="@+id/mobile_banner"
        android:layout_marginTop="10dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_mobiles"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_shop_by_brand"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
  

</androidx.constraintlayout.widget.ConstraintLayout>