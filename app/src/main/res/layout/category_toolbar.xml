<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:padding="12dp"
   >



    <com.google.android.material.card.MaterialCardView
        android:id="@+id/search_Bar"
        android:layout_width="0dp"
        android:layout_height="40dp"
        app:cardCornerRadius="6dp"
        app:cardElevation="5dp"
        app:cardBackgroundColor="@color/white"
        android:layout_marginEnd="15dp"
        android:layout_marginStart="15dp"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="0dp"
        app:strokeColor="@color/textSecondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivwishlist"
        app:layout_constraintStart_toStartOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/trennex_logo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/trennex_searchbar_logo" />

            <TextView
                android:id="@+id/searchHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Search in Trennex"
                android:textColor="@color/textPlaceholder"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="16dp"
                android:src="@drawable/search_icon" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <ImageView
        android:id="@+id/ivwishlist"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/wishlist_items"
        app:layout_constraintStart_toEndOf="@+id/search_Bar"
        app:layout_constraintEnd_toStartOf="@+id/ivcart"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <ImageView
        android:id="@+id/ivcart"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/cart"
        app:layout_constraintStart_toEndOf="@+id/ivwishlist"
        android:layout_marginHorizontal="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>



</androidx.constraintlayout.widget.ConstraintLayout>