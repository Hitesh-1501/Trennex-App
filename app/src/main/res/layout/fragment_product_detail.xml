<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.product.ProductDetailFragment">


    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomActionLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
           >

            <FrameLayout
                android:id="@+id/layout_image_banner"
                android:layout_width="match_parent"
                android:layout_height = "350dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/product_Banners"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                   />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="40dp"
                    android:gravity="center"
                    android:background="@drawable/rating_bg"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="4.3 ★"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" | 51"
                        android:layout_marginStart="2dp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        />


                </LinearLayout>

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/bannerIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_gravity="bottom|center"
                    android:layout_marginBottom="12dp"
                    app:tabIndicatorHeight="0dp"
                    android:background="@android:color/transparent"/>

            </FrameLayout>
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/layoutProductInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                   >

                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Samsung"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/black"/>

                    <TextView
                        android:id="@+id/tvProductTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Galaxy S24 5G Snapdragon (Onyx Black, 128 GB) (8 GB RAM)"
                        android:textSize="14sp"
                        android:textColor="@color/textPrimary"
                        android:layout_marginTop="4dp"/>

                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/tvMrp"
                            android:text="@string/mrp_text"
                            android:textColor="@color/textSecondary"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/tvPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" ₹40,999"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:layout_marginStart="8dp"/>

                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="@color/colorSurface"/>

                </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutVaiants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text ="Selected Color :"
                        android:textSize="14sp"
                        android:textColor="@color/textPrimary"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_selected_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="Onyx Black"
                        android:textSize="14sp"
                        android:textColor="@color/textPrimary"/>

                </LinearLayout>
                
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_color_variants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>



                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text ="Variant:"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvVariant"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="128GB + 8GB "
                        android:textSize="14sp"
                        android:textColor="@color/textPrimary"/>

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvVariants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/colorSurface"/>


            </LinearLayout>
            
            <LinearLayout
                android:id="@+id/layoutDelivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delivery &amp; Services"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_delivery_services"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:layout_marginTop="12dp">


                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="-2dp"
                        android:src="@drawable/product_detail_location"/>

                    <TextView
                        android:id="@+id/tvAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Address"
                        android:textSize="13sp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/textPrimary"/>


                    <TextView
                        android:id="@+id/tvChange"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Change"
                        android:textSize="13sp"
                        android:gravity="end"
                        android:layout_marginEnd="10dp"
                        android:textColor="@color/colorPrimary"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_delivery_services"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:layout_marginTop="12dp">


                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="-2dp"
                        android:src="@drawable/delivery_icon"/>

                    <TextView
                        android:id="@+id/tvDelivery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delivery By Tommarow, 12 Feb"
                        android:textSize="13sp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/textPrimary"/>


                    <TextView
                        android:id="@+id/tvPriceDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="₹ 40,999"
                        android:textSize="13sp"
                        android:gravity="end"
                        android:layout_marginEnd="10dp"
                        android:textColor="@color/textPrimary"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_delivery_services"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:layout_marginTop="12dp">


                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="-2dp"
                        android:src="@drawable/samsung_brand_logo"/>

                    <TextView
                        android:id="@+id/tvManufacture"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1-year Manufacture warranty for device"
                        android:textSize="13sp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/textPrimary"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_delivery_services"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:layout_marginTop="12dp">


                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="-2dp"
                        android:src="@drawable/return_policy"/>

                    <TextView
                        android:id="@+id/tv_return_policy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10-Day Return Policy"
                        android:textSize="13sp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/textPrimary"/>


                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/colorSurface"/>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutSpecs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">


                <LinearLayout
                    android:id="@+id/specheader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp"
                    android:gravity="center_vertical">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Specifications"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/textPrimary"/>


                    <ImageView
                        android:id="@+id/imgSpecArrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:padding="5dp"
                        android:background="@drawable/arrow_bg"
                        android:src="@drawable/arrow_down"/>

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/specContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingBottom="8dp">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Top Highlights"
                        android:textColor="@color/textPrimary"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp"
                        android:layout_marginTop="8dp">


                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_product_spec">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/product_spec_storage"/>

                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_spec_storage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8 GB RAM | 128 GB RAM"
                            android:layout_marginStart="10dp"
                            android:textColor="@color/textPrimary"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp"
                        android:layout_marginTop="8dp">


                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_product_spec">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/product_spec_processor"/>

                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_spec_processor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8 Gen 3 | Octa Core Processor | 3.39 GHz clock Speed"
                            android:layout_marginStart="10dp"
                            android:textColor="@color/textPrimary"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp"
                        android:layout_marginTop="8dp">


                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_product_spec">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/product_spec_camera"/>

                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_spec_camera"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="50MP + 12MP | 12MP Front Camera"
                            android:layout_marginStart="10dp"
                            android:textColor="@color/textPrimary"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp"
                        android:layout_marginTop="8dp">


                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_product_spec">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/product_spec_display"/>

                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_spec_display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15.75 cm (6.2 inch) Full HD+ Display"
                            android:layout_marginStart="10dp"
                            android:textColor="@color/textPrimary"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp"
                        android:layout_marginTop="8dp">


                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_product_spec">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/product_spec_battery"/>

                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_spec_battery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4000 mAh Battery"
                            android:layout_marginStart="10dp"
                            android:textColor="@color/textPrimary"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="See All Details"
                        android:layout_marginTop="5dp"
                        android:gravity="end"
                        android:textColor="@color/colorPrimary"/>


                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorSurface"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/layoutReviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:id="@+id/reviewheader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp"
                    android:gravity="center_vertical">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Reviews"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/textPrimary"/>


                    <ImageView
                        android:id="@+id/imgReviewArrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:padding="5dp"
                        android:background="@drawable/arrow_bg"
                        android:src="@drawable/arrow_down"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:id="@+id/review_content"
                    android:visibility="gone"
                    android:paddingTop="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/reviews_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/rating_bg"
                            android:text="4.1 ★"
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"/>

                        <TextView
                            android:id="@+id/tv_ratings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="51 ratings"
                            android:layout_marginStart="10dp"
                            android:textSize="13sp"
                            android:textColor="@color/textPrimary"/>

                        <TextView
                            android:id="@+id/tv_reviews"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" | 20 reviews"
                            android:layout_marginStart="5dp"
                            android:textSize="13sp"
                            android:textColor="@color/textPrimary"/>

                    </LinearLayout>
                    
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">


                            <ImageView
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                android:src="@drawable/sample_img"
                                android:scaleType="centerCrop"
                                android:layout_marginEnd="8dp"/>

                            <ImageView
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                android:src="@drawable/sample_img"
                                android:scaleType="centerCrop"
                                android:layout_marginEnd="8dp"/>

                            <FrameLayout
                                android:layout_width="70dp"
                                android:layout_height="70dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/sample_img" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:text="+10"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@android:color/white"
                                    android:gravity="center"
                                    android:background="@drawable/media_overlay" />

                            </FrameLayout>
                        </LinearLayout>
                    </HorizontalScrollView>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvReviews"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/tvViewAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="View all 20 reviews >"
                        android:textColor="@color/colorPrimary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorSurface"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomActionLayout"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="@color/white"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" >


        <ImageView
            android:id="@+id/wishlist"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/wishlist_product"/>


        <Button
            android:id="@+id/buy_now"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Buy Now"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:layout_marginHorizontal="30dp"
            android:background="@drawable/btn_selector"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/add_to_cart"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/shopping_cart_icon"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>