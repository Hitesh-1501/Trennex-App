<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minHeight="620dp"
            android:paddingStart="24dp"
            android:paddingTop="96dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/detailsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_account_details_card"
                android:elevation="5dp"
                android:orientation="vertical"
                android:padding="20dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/mobileInputLayout"
                    style="@style/AccountInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Mobile Number*"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_verified_green"
                    app:endIconTint="@color/colorSuccess"
                    app:suffixText="Change"
                    android:textColorHint="@color/textPlaceholder"
                    app:suffixTextAppearance="@style/TextAppearance.MaterialComponents.Body2"
                    app:suffixTextColor="@color/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMobile"
                        style="@style/LoginEditTextStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:maxLength="10"
                        android:textColor="@color/textPrimary"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="14dp"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

        </FrameLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/nameInputLayout"
            style="@style/AccountInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColorHint="@color/textPlaceholder"
            android:hint="Full Name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etName"
            style="@style/LoginEditTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName|textCapWords"
            android:paddingHorizontal="14dp"
            android:paddingVertical="14dp"
            android:textColor="@color/textPrimary"
            android:singleLine="true"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/emailInputLayout"
        style="@style/AccountInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColorHint="@color/textPlaceholder"
        android:hint="Email (Optional)">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/etEmail"
        style="@style/LoginEditTextStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textEmailAddress"
        android:textColor="@color/textPrimary"
        android:paddingHorizontal="14dp"
        android:paddingVertical="14dp"
        android:singleLine="true"
        android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveDetails"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginStart="28dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="28dp"
                    android:backgroundTint="@color/btnPrimary"
                    android:text="SAVE DETAILS"
                    android:textAllCaps="true"
                    android:textColor="@color/btnPrimaryText"
                    android:textSize="11sp"
                    app:cornerRadius="0dp"/>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@color/textSecondary"/>


                <TextView
                    android:id="@+id/tvDeleteAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="18dp"
                    android:text="DELETE ACCOUNT"
                    android:textColor="@color/colorPrimary"
                    android:textSize="11sp"/>

    </LinearLayout>

    </FrameLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>