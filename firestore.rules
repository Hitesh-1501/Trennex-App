rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function adminGrantAllows(scope) {
      let grant = get(/databases/$(database)/documents/adminRoleGrants/$(request.auth.uid)).data;
      return grant.targetUid == request.auth.uid
        && grant.active == true
        && grant.operationState == 'SUCCEEDED'
        && grant.version is int
        && grant.version >= 1
        && grant.scopes is list
        && scope in grant.scopes;
    }

    function hasAdminScope(scope) {
      return signedIn()
        && request.auth.token.get('trennexRole', '') == 'admin'
        && adminGrantAllows(scope);
    }

    function onlyFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function optionalString(data, key, maxLength) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLength);
    }

    function optionalTimestamp(data, key) {
      return !(key in data) || data[key] is timestamp;
    }

    function optionalNumber(data, key, minimum, maximum) {
      return !(key in data) || (data[key] is number
        && data[key] >= minimum && data[key] <= maximum);
    }

    function activeDocument() {
      return ('status' in resource.data && resource.data.status == 'ACTIVE')
        || ('active' in resource.data && resource.data.active == true);
    }

    function legacyProductDocument(data) {
      return !('schemaVersion' in data)
        && !('status' in data)
        && !('active' in data)
        && 'id' in data
        && data.id is int
        && 'title' in data
        && data.title is string
        && 'price' in data;
    }

    function legacyCategoryDocument(data) {
      return !('schemaVersion' in data)
        && !('status' in data)
        && !('active' in data)
        && 'slug' in data
        && data.slug is string
        && 'name' in data
        && data.name is string;
    }

    function parentProductIsReadable(productId) {
      let product = get(/databases/$(database)/documents/products/$(productId)).data;
      return legacyProductDocument(product)
        || ('status' in product && product.status == 'ACTIVE');
    }

    function parentHomeSectionIsActive(sectionId) {
      return get(/databases/$(database)/documents/homeSections/$(sectionId)).data.active == true;
    }

    function ownsOrder(orderId) {
      return signedIn()
        && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid;
    }

    match /products/{productId} {
      allow read: if hasAdminScope('catalog') || legacyProductDocument(resource.data)
        || ('status' in resource.data && resource.data.status == 'ACTIVE');
      allow write: if hasAdminScope('catalog');

      match /variants/{variantId} {
        allow read: if hasAdminScope('catalog') || parentProductIsReadable(productId);
        allow write: if hasAdminScope('catalog');
      }

      match /reviews/{reviewId} {
        allow read: if hasAdminScope('reviews')
          || resource.data.status == 'PUBLISHED'
          || (signedIn() && resource.data.userId == request.auth.uid);
        allow write: if hasAdminScope('reviews');
      }
    }

    match /categories/{categoryId} {
      allow read: if hasAdminScope('catalog') || legacyCategoryDocument(resource.data) || activeDocument();
      allow write: if hasAdminScope('catalog');
    }

    match /brands/{brandId} {
      allow read: if hasAdminScope('catalog') || activeDocument();
      allow write: if hasAdminScope('catalog');
    }

    match /banners/{bannerId} {
      allow read: if hasAdminScope('catalog') || resource.data.active == true;
      allow write: if hasAdminScope('catalog');
    }

    match /homeSections/{sectionId} {
      allow read: if hasAdminScope('catalog') || resource.data.active == true;
      allow write: if hasAdminScope('catalog');

      match /items/{itemId} {
        allow read: if hasAdminScope('catalog') || parentHomeSectionIsActive(sectionId);
        allow write: if hasAdminScope('catalog');
      }
    }

    match /inventory/{inventoryId} {
      allow read, write: if hasAdminScope('inventory');
    }

    match /coupons/{couponId} {
      allow read, write: if hasAdminScope('promotions');

      match /redemptions/{redemptionId} {
        allow read, write: if hasAdminScope('promotions');
      }
    }

    match /users/{userId} {
      allow read: if owns(userId);
      allow create, update: if owns(userId)
        && onlyFields([
          'schemaVersion', 'displayName', 'name', 'email', 'phoneE164', 'phone',
          'photoUrl', 'selectedAddressId', 'preferences', 'createdAt', 'updatedAt',
          'lastLoginAt'
        ])
        && (!('schemaVersion' in request.resource.data) || request.resource.data.schemaVersion == 1)
        && optionalString(request.resource.data, 'displayName', 120)
        && optionalString(request.resource.data, 'name', 120)
        && optionalString(request.resource.data, 'email', 254)
        && optionalString(request.resource.data, 'phoneE164', 20)
        && optionalString(request.resource.data, 'phone', 20)
        && optionalString(request.resource.data, 'photoUrl', 2048)
        && optionalString(request.resource.data, 'selectedAddressId', 128)
        && (!('preferences' in request.resource.data) || request.resource.data.preferences is map)
        && optionalTimestamp(request.resource.data, 'createdAt')
        && optionalTimestamp(request.resource.data, 'updatedAt')
        && optionalTimestamp(request.resource.data, 'lastLoginAt')
        && (request.method == 'create' || !('createdAt' in resource.data)
          || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if false;

      match /savedAddresses/{addressId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId)
          && onlyFields([
            'schemaVersion', 'label', 'fullName', 'phoneE164', 'line1', 'line2',
            'landmark', 'city', 'state', 'postalCode', 'countryCode', 'location',
            'isDefault', 'createdAt', 'updatedAt',
            'flatNo', 'address', 'userName', 'mobile', 'latitude', 'longitude',
            'placeName', 'addressType'
          ])
          && (!('schemaVersion' in request.resource.data) || request.resource.data.schemaVersion == 1)
          && optionalString(request.resource.data, 'address', 500)
          && optionalString(request.resource.data, 'flatNo', 200)
          && optionalString(request.resource.data, 'userName', 120)
          && optionalString(request.resource.data, 'mobile', 20)
          && optionalString(request.resource.data, 'placeName', 200)
          && optionalString(request.resource.data, 'addressType', 40)
          && optionalNumber(request.resource.data, 'latitude', -90, 90)
          && optionalNumber(request.resource.data, 'longitude', -180, 180)
          && optionalTimestamp(request.resource.data, 'createdAt')
          && optionalTimestamp(request.resource.data, 'updatedAt');
      }

      match /cartItems/{cartItemId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId)
          && onlyFields([
            'schemaVersion', 'productId', 'variantId', 'quantity', 'selected',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.productId is string
          && request.resource.data.productId.size() > 0
          && request.resource.data.productId.size() <= 128
          && request.resource.data.variantId is string
          && request.resource.data.variantId.size() > 0
          && request.resource.data.variantId.size() <= 128
          && request.resource.data.quantity is int
          && request.resource.data.quantity >= 1
          && request.resource.data.quantity <= 10
          && request.resource.data.selected is bool
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
      }

      // Temporary compatibility for the current Android model. Remove after migration.
      match /cart/{cartItemId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId)
          && onlyFields([
            'id', 'title', 'description', 'mrp', 'price', 'rating', 'ratingCount',
            'returnPolicy', 'deliveryDetails', 'imageUrl', 'imageRes', 'quantity',
            'isSelected'
          ])
          && request.resource.data.id is int
          && request.resource.data.id >= 0
          && request.resource.data.quantity is int
          && request.resource.data.quantity >= 1
          && request.resource.data.quantity <= 10
          && optionalNumber(request.resource.data, 'price', 0, 100000000)
          && optionalNumber(request.resource.data, 'mrp', 0, 100000000);
      }

      match /wishlistItems/{wishlistItemId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId)
          && onlyFields([
            'schemaVersion', 'productId', 'variantId', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.productId is string
          && request.resource.data.productId.size() > 0
          && request.resource.data.productId.size() <= 128
          && request.resource.data.variantId is string
          && request.resource.data.variantId.size() > 0
          && request.resource.data.variantId.size() <= 128;
      }

      // Temporary compatibility for the current Android model. Remove after migration.
      match /wishlist/{wishlistItemId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId)
          && onlyFields([
            'id', 'imageUrl', 'title', 'description', 'mrp', 'price', 'rating',
            'ratingCount', 'returnPolicy', 'deliveryDetails'
          ])
          && request.resource.data.id is int
          && request.resource.data.id >= 0;
      }

      match /collections/{collectionId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId)
          && onlyFields(['name', 'createdAt', 'updatedAt']);

        match /items/{itemId} {
          allow read, delete: if owns(userId);
          allow create, update: if owns(userId)
            && onlyFields(['productId', 'variantId', 'createdAt']);
        }
      }

      match /notifications/{notificationId} {
        allow read: if owns(userId);
        allow create, delete: if false;
        allow update: if owns(userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
            && request.resource.data.readAt is timestamp;
      }

      // Legacy orders remain readable, but only trusted server/admin operations may write them.
      match /orders/{orderId} {
        allow read: if owns(userId);
        allow write: if false;
      }

      // Client checkout requests are untrusted input. A trusted server function
      // validates prices, stock, address, and payment before creating top-level orders.
      match /orderRequests/{requestId} {
        allow create: if owns(userId)
          && onlyFields([
            'schemaVersion', 'status', 'items', 'itemCount',
            'shippingAddress', 'recipient', 'payment', 'createdAt'
          ])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.status == 'PENDING'
          && request.resource.data.items is list
          && request.resource.data.items.size() >= 1
          && request.resource.data.items.size() <= 50
          && request.resource.data.itemCount is int
          && request.resource.data.itemCount >= 1
          && request.resource.data.itemCount <= 500
          && request.resource.data.shippingAddress is map
          && request.resource.data.recipient is map
          && request.resource.data.payment is map
          && request.resource.data.payment.keys().hasOnly(['method'])
          && request.resource.data.payment.method == 'COD'
          && request.resource.data.createdAt is timestamp;
        allow read: if owns(userId);
        allow update, delete: if false;
      }
    }

    match /orders/{orderId} {
      allow read: if hasAdminScope('orders')
        || (signedIn() && resource.data.userId == request.auth.uid);
      // Status, totals, ownership and fulfillment remain server-managed.
      allow write: if false;

      match /items/{itemId} {
        allow read: if hasAdminScope('orders') || ownsOrder(orderId);
        allow write: if false;
      }

      match /events/{eventId} {
        allow read: if hasAdminScope('orders') || ownsOrder(orderId);
        allow write: if false;
      }
    }

    match /appConfig/{configId} {
      allow read: if configId == 'public';
      allow write: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read: if hasAdminScope('audit');
      allow write: if false;
    }

    // Only a trusted Admin SDK workflow can issue or revoke scoped grants.
    match /adminRoleGrants/{userId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
