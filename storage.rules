rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasMediaAdminGrant() {
      let grant = firestore.get(/databases/(default)/documents/adminRoleGrants/$(request.auth.uid)).data;
      return grant.active == true
        && grant.scopes is list
        && 'media' in grant.scopes;
    }

    function isMediaAdmin() {
      return signedIn()
        && request.auth.token.get('trennexRole', '') == 'admin'
        && hasMediaAdminGrant();
    }

    function isImageUnder(maxBytes) {
      return request.resource.size > 0
        && request.resource.size < maxBytes
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function safeImageName(fileName) {
      return fileName.matches('[A-Za-z0-9_-]+\\.(jpg|jpeg|png|webp)');
    }

    match /catalog/categories/{fileName} {
      allow read: if safeImageName(fileName);
      allow create, update: if isMediaAdmin() && safeImageName(fileName) && isImageUnder(10 * 1024 * 1024);
      allow delete: if isMediaAdmin() && safeImageName(fileName);
    }

    match /catalog/banners/{fileName} {
      allow read: if safeImageName(fileName);
      allow create, update: if isMediaAdmin() && safeImageName(fileName) && isImageUnder(10 * 1024 * 1024);
      allow delete: if isMediaAdmin() && safeImageName(fileName);
    }

    match /catalog/products/{productId}/{fileName} {
      allow read: if safeImageName(fileName);
      allow create, update: if isMediaAdmin() && safeImageName(fileName) && isImageUnder(10 * 1024 * 1024);
      allow delete: if isMediaAdmin() && safeImageName(fileName);
    }

    match /users/{userId}/{fileName} {
      allow read: if owns(userId);
      allow create, update: if owns(userId)
        && fileName.matches('avatar\\.(jpg|jpeg|png|webp)')
        && isImageUnder(5 * 1024 * 1024);
      allow delete: if owns(userId);
    }

    match /orders/{userId}/{allPaths=**} {
      allow read: if owns(userId);
      // No order-media upload flow exists yet. Future B7/F work must define a schema.
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
